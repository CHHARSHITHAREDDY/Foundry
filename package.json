{
  "name": "venture-studio",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "api:dev": "pnpm --filter @venture-studio/api dev",
    "api:build": "pnpm --filter @venture-studio/api build",
    "api:start": "pnpm --filter @venture-studio/api start",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "evals": "pnpm --filter evals run eval",
    "check:boundaries": "depcruise services apps packages --config .dependency-cruiser.cjs",
    "gen:openapi": "tsx scripts/generate-openapi.ts",
    "db:migrate": "tsx scripts/db-migrate-all.ts",
    "infra:up": "docker compose -f infra/docker/compose.dev.yml up -d",
    "infra:down": "docker compose -f infra/docker/compose.dev.yml down"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@types/node": "^20.14.9",
    "dependency-cruiser": "^16.4.0",
    "husky": "^9.1.0",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "turbo": "^2.1.0",
    "typescript": "^5.6.0"
  }
}
