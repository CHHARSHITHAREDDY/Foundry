datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

enum UserRole {
  FOUNDER
  ADMIN
  MEMBER
}

enum VerdictStatus {
  GO
  GO_WITH_CHANGES
  NO_GO
  INSUFFICIENT_DATA
}

enum RunStage {
  PENDING
  ARCHITECTING
  BUILDING
  INTEGRATING
  QA
  REVIEW
  DEPLOY
  COMPLETED
  FAILED
}

enum DeploymentStatus {
  BUILDING
  LIVE
  SIMULATED
  FAILED
  ARCHIVED
}

model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  name                String
  role                UserRole  @default(FOUNDER)
  credits             Int       @default(0)
  passwordHash        String?   @map("password_hash")
  emailVerifiedAt     DateTime? @map("email_verified_at")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  twoFactorEnabled    Boolean   @default(false) @map("two_factor_enabled")
  demo                Boolean   @default(false)
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  ventures           Venture[]
  notifications      Notification[]
  creditLedger       CreditLedger[]
  sessions           Session[]
  emailVerifications EmailVerification[]
  passwordResets     PasswordReset[]
  twoFactor          TwoFactor?

  @@map("users")
}

model Session {
  id                 String    @id @default(uuid())
  userId             String    @map("user_id")
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash          String    @unique @map("token_hash")
  csrfToken          String    @map("csrf_token")
  userAgent          String?   @map("user_agent")
  ipAddress          String?   @map("ip_address")
  trustedDeviceUntil DateTime? @map("trusted_device_until")
  expiresAt          DateTime  @map("expires_at")
  revokedAt          DateTime? @map("revoked_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("sessions")
}

model EmailVerification {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("email_verifications")
}

model PasswordReset {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("password_resets")
}

model TwoFactor {
  id            String   @id @default(uuid())
  userId        String   @unique @map("user_id")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  secret        String
  recoveryCodes String[] @default([]) @map("recovery_codes")
  enabled       Boolean  @default(false)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("two_factor")
}

model DevOutbox {
  id        String   @id @default(uuid())
  to        String
  subject   String
  body      String   @db.Text
  link      String?
  type      String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("dev_outbox")
}

model BillingPlan {
  id                String   @id
  name              String
  priceMonthlyCents Int      @map("price_monthly_cents")
  credits           Int
  maxActiveVentures Int      @map("max_active_ventures")
  features          String[] @default([])
  active            Boolean  @default(true)
  sortOrder         Int      @default(0) @map("sort_order")

  @@map("billing_plans")
}

model PricingConfig {
  action      String @id
  label       String
  credits     Int
  description String

  @@map("pricing_configs")
}

model Venture {
  id                      String           @id @default(uuid())
  title                   String
  tagline                 String?
  problem                 String           @db.Text
  targetCustomer          String           @map("target_customer")
  jobToBeDone             String?          @db.Text @map("job_to_be_done")
  whyNow                  String?          @db.Text @map("why_now")
  wedge                   String?          @db.Text
  archetype               String?
  mvpScope                Json?            @map("mvp_scope")
  batchId                 String?          @map("batch_id")
  ideaStatus              String           @default("CANDIDATE") @map("idea_status") // DRAFT | CANDIDATE | APPROVED | REJECTED
  clarifyQuestions        Json?            @map("clarify_questions")
  verdict                 VerdictStatus    @default(INSUFFICIENT_DATA)
  verdictLabel            String           @default("INSUFFICIENT_DATA") @map("verdict_label") // PRELIMINARY | INSUFFICIENT_DATA | NO_GO_SIGNALS
  totalScore              Float?           @map("total_score")
  scorecardType           String           @default("INSUFFICIENT_DATA") @map("scorecard_type")
  assessedDimensionsCount Int              @default(0) @map("assessed_dimensions_count")
  subdomain               String?          @unique
  status                  DeploymentStatus @default(BUILDING)
  demo                    Boolean          @default(false)
  ownerId                 String           @map("owner_id")
  owner                   User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt               DateTime         @default(now()) @map("created_at")
  updatedAt               DateTime         @updatedAt @map("updated_at")

  scorecard   Scorecard?
  evidence    EvidenceCitation[]
  competitors CompetitorRecord[]
  runs        WorkflowRun[]

  @@index([ownerId, ideaStatus, createdAt])
  @@map("ventures")
}

model Scorecard {
  id              String   @id @default(uuid())
  ventureId       String   @unique @map("venture_id")
  venture         Venture  @relation(fields: [ventureId], references: [id], onDelete: Cascade)
  demand          Float?
  competition     Float?
  differentiation Float?
  monetization    Float?
  buildability    Float?
  total           Float?
  scorecardType   String   @default("INSUFFICIENT_DATA") @map("scorecard_type")
  basis           Json?
  sources         String[] @default([])
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("scorecards")
}

model EvidenceCitation {
  id               String   @id @default(uuid())
  ventureId        String   @map("venture_id")
  venture          Venture  @relation(fields: [ventureId], references: [id], onDelete: Cascade)
  painPointId      String?  @map("pain_point_id")
  source           String   // e.g. "Hacker News (Ask HN)", "GitHub (drizzle-team)"
  url              String
  quote            String   @db.Text
  sourceType       String   @default("LIVE_API") @map("source_type") // "LIVE_API" | "SAMPLE_SPECIMEN"
  citationVerified Boolean  @default(true) @map("citation_verified")
  sampleNotice     String?  @db.Text @map("sample_notice")
  sourceCreatedAt  DateTime? @map("source_created_at")
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("evidence_citations")
}

model CompetitorRecord {
  id          String   @id @default(uuid())
  ventureId   String   @map("venture_id")
  venture     Venture  @relation(fields: [ventureId], references: [id], onDelete: Cascade)
  name        String
  url         String?
  pricingText String?  @db.Text @map("pricing_text")
  gap         String?  @db.Text
  fetchedAt   DateTime @default(now()) @map("fetched_at")

  @@map("competitor_records")
}

model PainPointRecord {
  id                    String   @id @default(uuid())
  source                String
  url                   String   @unique
  quote                 String   @db.Text
  problem               String   @db.Text
  persona               String
  currentWorkaround     String?  @db.Text @map("current_workaround")
  severitySignals       String?  @db.Text @map("severity_signals")
  willingnessToPayClues String?  @db.Text @map("willingness_to_pay_clues")
  origin                String   @default("LIVE")
  citationVerified      Boolean  @default(true) @map("citation_verified")
  embedding             Float[]  @default([])
  sourceCreatedAt       DateTime @map("source_created_at")
  createdAt             DateTime @default(now()) @map("created_at")

  @@map("pain_points")
}

model IdeaJob {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  mode           String   // "SURPRISE" | "CUSTOM"
  status         String   @default("RUNNING") // "RUNNING" | "COMPLETED" | "INSUFFICIENT_LIVE_DATA" | "FAILED" | "CANCELLED"
  promptText     String?  @db.Text @map("prompt_text")
  sourcesSummary Json?    @map("sources_summary")
  droppedLog     Json?    @map("dropped_log")
  resultIdeaId   String?  @map("result_idea_id")
  error          String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([userId, createdAt])
  @@map("idea_jobs")
}

model UserSeenIdea {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  title     String
  problem   String   @db.Text
  embedding Float[]  @default([])
  status    String   @default("SHOWN") // "SHOWN" | "APPROVED" | "REJECTED"
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("user_seen_ideas")
}

model CreditLedger {
  id             String   @id @default(uuid())
  idempotencyKey String?  @unique @map("idempotency_key")
  userId         String   @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action         String   // "RESERVE" | "SETTLE" | "REFUND" | "BONUS"
  amount         Int      // e.g. -5, -25
  balance        Int      // Balance remaining after ledger entry
  reason         String   // e.g. "SURPRISE_ME_SCOUT", "SWARM_BUILD_RESERVE", "STAGE_ARCHITECT_SETTLE"
  stage          String?
  runId          String?  @map("run_id")
  tokensIn       Int      @default(0) @map("tokens_in")
  tokensOut      Int      @default(0) @map("tokens_out")
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("credit_ledger")
}

model WorkflowRun {
  id             String           @id @default(uuid())
  ventureId      String           @map("venture_id")
  venture        Venture          @relation(fields: [ventureId], references: [id], onDelete: Cascade)
  ownerId        String?          @map("owner_id")
  currentStage   RunStage         @default(PENDING) @map("current_stage")
  completedStages String[]        @default([]) @map("completed_stages")
  logs           String[]         @default([])
  totalTokensIn  Int              @default(0) @map("total_tokens_in")
  totalTokensOut Int              @default(0) @map("total_tokens_out")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  checkpoints RunStageCheckpoint[]
  artifacts   BuildArtifact[]

  @@map("workflow_runs")
}

model RunStageCheckpoint {
  id          String    @id @default(uuid())
  runId       String    @map("run_id")
  run         WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  stage       RunStage
  status      String    // "PENDING" | "RUNNING" | "COMPLETED" | "FAILED" | "NOT_RUN" | "SIMULATED"
  input       Json?
  output      Json?
  tokensIn    Int       @default(0) @map("tokens_in")
  tokensOut   Int       @default(0) @map("tokens_out")
  durationMs  Int       @default(0) @map("duration_ms")
  error       String?   @db.Text
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([runId, stage])
  @@map("run_stage_checkpoints")
}

model BuildArtifact {
  id        String      @id @default(uuid())
  runId     String      @map("run_id")
  run       WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  filePath  String      @map("file_path")
  content   String      @db.Text
  fileType  String      @map("file_type")
  createdAt DateTime    @default(now()) @map("created_at")

  @@map("build_artifacts")
}

model StudioEvent {
  id        String   @id @default(uuid())
  runId     String?  @map("run_id")
  stream    String   @default("sse:studio")
  eventType String   @map("event_type") // e.g. "STAGE_TRANSITION", "TASK_UPDATED", "TOKEN_METERED"
  payload   Json
  timestamp DateTime @default(now())

  @@index([stream, timestamp])
  @@map("studio_events")
}

model PaymentAccount {
  id              String   @id @default(uuid())
  companyId       String   @unique @map("company_id")
  stripeAccountId String   @unique @map("stripe_account_id")
  chargesEnabled  Boolean  @default(false) @map("charges_enabled")
  payoutsEnabled  Boolean  @default(false) @map("payouts_enabled")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("payment_accounts")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String   @db.Text
  read      Boolean  @default(false)
  demo      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("notifications")
}

model AuditLog {
  id        String   @id @default(uuid())
  actor     String
  action    String
  target    String
  metadata  Json?
  timestamp DateTime @default(now())

  @@map("audit_logs")
}
